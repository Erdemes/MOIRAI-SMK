<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MOIRAI.ViewModels"
             xmlns:domain="using:MOIRAI.Domain"
             x:Class="MOIRAI.Views.LocationsView"
             x:DataType="vm:LocationsViewModel">
    <Grid Margin="20" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,18">
            <TextBlock Classes="h1" Text="Locations"/>
            <TextBlock Classes="h1" Foreground="{DynamicResource TextMuted}" Text="- Remote operating bases"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="280,18,*">

            <DockPanel Grid.Column="0">
                <Button DockPanel.Dock="Bottom" Classes="ghost" Margin="0,10,0,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding NewCommand}" Content="+ New location"/>
                <Border Classes="card" Padding="6">
                    <ListBox ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:Location">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="14"/>
                                    <TextBlock Classes="muted" Text="{Binding FerryDays, StringFormat='Ferry {0} day(s) each way'}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <Border Grid.Column="2" Classes="card">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,10">
                        <TextBlock Classes="h2" Text="Location Details"/>

                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   IsVisible="{Binding !HasSelection}"
                                   Text="Select a location."/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding HasSelection}">
                        <StackPanel Spacing="14" Margin="0,0,12,0">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="Name"/>
                                <TextBox Text="{Binding EditName}" PlaceholderText="e.g. Konya Range"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="Test range location (animation map)"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Classes="ghost" Content="📍 Pick on map…"
                                            Command="{Binding PickLocationCommand}"/>
                                    <TextBlock VerticalAlignment="Center" Classes="muted"
                                               Text="{Binding CoordinatesText}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Classes="h2" Text="Capability at this base"/>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="Blocks/day cap (0 = full)"/>
                                <NumericUpDown Value="{Binding EditBlocksCap}" Minimum="0" Increment="1"
                                               FormatString="0" Width="160"/>
                                <TextBlock Classes="label" TextWrapping="Wrap" MaxWidth="420"
                                           Text="Without a local simulator, rehearsals must finish at the main base before departure."/>
                            </StackPanel>

                            <TextBlock Classes="h2" Text="Transit from the main base (each way)"/>
                            <WrapPanel>
                                <StackPanel Spacing="4" Margin="0,0,16,6">
                                    <TextBlock Classes="label" Text="Ferry (days)"/>
                                    <NumericUpDown Value="{Binding EditFerryDays}" Minimum="0" Increment="1" FormatString="0" Width="120"/>
                                </StackPanel>
                                <StackPanel Spacing="4" Margin="0,0,16,6">
                                    <TextBlock Classes="label" Text="Ferry flight hours"/>
                                    <NumericUpDown Value="{Binding EditFerryFlightHours}" Minimum="0" Increment="0.5" FormatString="0.#" Width="140"/>
                                </StackPanel>
                                <StackPanel Spacing="4" Margin="0,0,16,6">
                                    <TextBlock Classes="label" Text="Ferry duty hours"/>
                                    <NumericUpDown Value="{Binding EditFerryDutyHours}" Minimum="0" Increment="0.5" FormatString="0.#" Width="140"/>
                                </StackPanel>
                                <StackPanel Spacing="4" Margin="0,0,16,6">
                                    <TextBlock Classes="label" Text="Setup (days)"/>
                                    <NumericUpDown Value="{Binding EditSetupDays}" Minimum="0" Increment="1" FormatString="0" Width="120"/>
                                </StackPanel>
                                <StackPanel Spacing="4" Margin="0,0,16,6">
                                    <TextBlock Classes="label" Text="Teardown (days)"/>
                                    <NumericUpDown Value="{Binding EditTeardownDays}" Minimum="0" Increment="1" FormatString="0" Width="120"/>
                                </StackPanel>
                                <StackPanel Spacing="4" Margin="0,0,16,6">
                                    <TextBlock Classes="label" Text="Crew rest after return (days)"/>
                                    <NumericUpDown Value="{Binding EditPostDeploymentRestDays}" Minimum="0" Increment="1" FormatString="0" Width="120" ToolTip.Tip="Crew cannot fly or rehearse during these calendar days."/>
                                </StackPanel>
                            </WrapPanel>

                            <TextBlock Classes="h2" Text="Weather at this base"/>
                            <CheckBox Content="Use the scenario's weather model"
                                      IsChecked="{Binding EditUseScenarioWeather}"/>
                            <StackPanel Spacing="8" IsVisible="{Binding OverrideWeather}">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="label" Text="Weather model"/>
                                    <ComboBox SelectedIndex="{Binding EditWeatherModelIndex}" Width="300" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="Uniform rate"/>
                                        <ComboBoxItem Content="Seasonal (monthly rates)"/>
                                    </ComboBox>
                                </StackPanel>

                                <WrapPanel IsVisible="{Binding IsWeatherUniform}">
                                    <StackPanel Spacing="4" Margin="0,0,16,6">
                                        <TextBlock Classes="label" Text="Flyable rate (0-1)"/>
                                        <NumericUpDown Value="{Binding EditWeatherRate}" Minimum="0" Maximum="1"
                                                       Increment="0.05" FormatString="0.0#" Width="140"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4" Margin="0,0,16,6">
                                        <TextBlock Classes="label" Text="Persistence φ (0-0.98)"/>
                                        <NumericUpDown Value="{Binding EditWeatherPersistence}" Minimum="0" Maximum="0.98"
                                                       Increment="0.05" FormatString="0.0#" Width="150"/>
                                    </StackPanel>
                                </WrapPanel>

                                <StackPanel Spacing="8" IsVisible="{Binding IsWeatherSeasonal}">
                                    <TextBlock Classes="label" Text="Monthly flyable rates (0-1)"/>
                                    <ItemsControl ItemsSource="{Binding WeatherMonthlyRates}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MonthRateOption">
                                                <StackPanel Spacing="2" Margin="0,0,10,10">
                                                    <TextBlock Classes="label" Text="{Binding Month}"/>
                                                    <NumericUpDown Value="{Binding Rate}" Minimum="0" Maximum="1"
                                                                   MinWidth="110" Increment="0.05" FormatString="0.0#"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="label" Text="Persistence φ (0-0.98)"/>
                                        <NumericUpDown Value="{Binding EditWeatherPersistence}" Minimum="0" Maximum="0.98"
                                                       Increment="0.05" FormatString="0.0#" Width="150"/>
                                    </StackPanel>

                                </StackPanel>
                            </StackPanel>

                            <TextBlock Classes="h2" Text="Range / airspace availability"/>
                            <CheckBox Content="Range always available"
                                      IsChecked="{Binding EditRangeAlwaysAvailable}" ToolTip.Tip="When off, models booking losses. Higher persistence groups losses into longer periods."/>
                            <WrapPanel IsVisible="{Binding HasRangeRisk}">
                                <StackPanel Spacing="4" Margin="0,0,16,6">
                                    <TextBlock Classes="label" Text="Availability rate (0-1)"/>
                                    <NumericUpDown Value="{Binding EditRangeRate}" Minimum="0" Maximum="1"
                                                   Increment="0.05" FormatString="0.0#" Width="140"/>
                                </StackPanel>
                                <StackPanel Spacing="4" Margin="0,0,16,6">
                                    <TextBlock Classes="label" Text="Persistence φ (0-0.98)"/>
                                    <NumericUpDown Value="{Binding EditRangePersistence}" Minimum="0" Maximum="0.98"
                                                   Increment="0.05" FormatString="0.0#" Width="150"/>
                                </StackPanel>
                            </WrapPanel>

                            <StackPanel Spacing="4" IsVisible="{Binding HasAssignedCampaigns}">
                                <TextBlock Classes="label" Text="Campaigns at this location"/>
                                <ItemsControl ItemsSource="{Binding AssignedCampaigns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="domain:Campaign">
                                            <TextBlock Text="{Binding Name}" Classes="muted"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}"
                                       IsVisible="{Binding HasError}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,14,0,0"
                                IsVisible="{Binding HasSelection}">
                        <Button Content="Save" Command="{Binding SaveCommand}"
                                Background="{DynamicResource Accent}" Foreground="White" Padding="22,7"/>
                        <Button Content="Delete" Classes="danger" Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
