<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MOIRAI.Views.NewPlanDialog"
        Title="New scenario"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}">

    <StackPanel Margin="24" Spacing="14">
        <TextBlock Classes="h2" Text="New scenario"/>

        <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Scenario name"/>
            <TextBox x:Name="NameBox" PlaceholderText="e.g. Baseline / +1 aircraft / Winter"/>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Copies the current scenario, including resources and settings."/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" IsVisible="False"
                   Foreground="{DynamicResource Danger}"/>

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="Cancel" Click="OnCancel"/>
            <Button Content="Create" Click="OnCreate" IsDefault="True"
                    Background="{DynamicResource Accent}" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>
