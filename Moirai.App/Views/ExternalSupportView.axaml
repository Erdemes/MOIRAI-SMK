<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MOIRAI.ViewModels"
             xmlns:domain="using:MOIRAI.Domain"
             x:Class="MOIRAI.Views.ExternalSupportView"
             x:DataType="vm:ExternalSupportViewModel">
    <Grid Margin="20" RowDefinitions="Auto,Auto,*">
        <TextBlock Grid.Row="0" Classes="h1" Text="External Support" Margin="0,0,0,8"/>

        <Border Grid.Row="1" Classes="card" Margin="0,0,0,14" Padding="14,10">
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Summary}"/>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="280,18,*">

            <DockPanel Grid.Column="0">
                <Button DockPanel.Dock="Bottom" Classes="ghost" Margin="0,10,0,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="OnNewAsset" Content="+ New external support"/>
                <Border Classes="card" Padding="6">
                    <ListBox ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:ExternalSupport">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="14"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <Border Grid.Column="2" Classes="card">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Spacing="14" Margin="0,0,0,14">
                        <TextBlock Classes="h2" Text="External Support Details"/>
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   IsVisible="{Binding !HasSelection}"
                                   Text="Select an external asset."/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding HasSelection}">
                        <StackPanel Spacing="14" Margin="0,0,12,0">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="Name"/>
                                <TextBox Text="{Binding EditName}" PlaceholderText="e.g. KC-135R tanker / F-16 chase"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="Max sorties supported per day (0 = unlimited)"/>
                                <NumericUpDown Value="{Binding EditMaxSortiesPerDay}"
                                               Minimum="0" Increment="1" FormatString="0" Width="180"
                                               HorizontalAlignment="Left"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="label" Text="Allocation / booking availability"/>
                                <CheckBox Content="Always available"
                                          IsChecked="{Binding EditAlwaysAvailable}"/>
                                <StackPanel Spacing="8" IsVisible="{Binding OverrideAvailability}">
                                    <Grid ColumnDefinitions="*,14,*">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Classes="label" Text="Availability rate (0-1)"/>
                                            <NumericUpDown Value="{Binding EditAvailabilityRate}"
                                                           Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Classes="label" Text="Persistence (0-0.98)"/>
                                            <NumericUpDown Value="{Binding EditAvailabilityPersistence}"
                                                           Minimum="0" Maximum="0.98" Increment="0.05" FormatString="0.##"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Spacing="10" Margin="0,14,0,0"
                                IsVisible="{Binding HasSelection}">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Danger}"
                                   IsVisible="{Binding HasError}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Save" Command="{Binding SaveCommand}"
                                    Background="{DynamicResource Accent}" Foreground="White"/>
                            <Button Classes="danger" Content="Delete"
                                    Command="{Binding DeleteCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
