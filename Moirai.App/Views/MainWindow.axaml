<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MOIRAI.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="MOIRAI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/moirai.ico"
        Background="{DynamicResource AppBg}"
        Width="1200" Height="760"
        MinWidth="900" MinHeight="600"
        WindowState="Maximized"
        Title="{Binding WindowTitle}">

    <DockPanel>

        <Menu DockPanel.Dock="Top" Background="{DynamicResource SidebarBg}">
            <MenuItem Header="_File">
                <MenuItem Header="_New Session" Command="{Binding NewSessionCommand}"/>
                <Separator/>
                <MenuItem Header="_Open Session…" Command="{Binding OpenSessionCommand}"/>
                <MenuItem Header="Save Session _As…" Command="{Binding SaveSessionAsCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Open User _Manual" Command="{Binding OpenUserManualCommand}"/>
                <Separator/>
                <MenuItem Header="_About MOIRAI" Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0"
                Padding="14,5" MinHeight="26">
            <TextBlock Text="{Binding StatusMessage}" Classes="muted" VerticalAlignment="Center"/>
        </Border>

        <SplitView x:Name="NavSplit" IsPaneOpen="True" DisplayMode="CompactInline"
                   OpenPaneLength="280" CompactPaneLength="68"
                   PaneBackground="{DynamicResource SidebarBg}">
            <SplitView.Pane>
                <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Classes="ghost" Content="☰" Width="36"
                                Margin="16,12,0,0" HorizontalAlignment="Left"
                                HorizontalContentAlignment="Center"
                                Click="OnToggleNav" ToolTip.Tip="Toggle sidebar"/>

                        <StackPanel DockPanel.Dock="Top" Margin="20,10,20,8" Spacing="2"
                                    IsVisible="{Binding #NavSplit.IsPaneOpen}">
                            <Image Source="/Assets/moirai-lockup-white.png"
                                   Width="200" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <Image DockPanel.Dock="Top" Source="/Assets/moirai-mark-mono-white.png"
                               Width="36" Margin="16,12,0,8" HorizontalAlignment="Left"
                               IsVisible="{Binding !#NavSplit.IsPaneOpen}"/>

                        <StackPanel DockPanel.Dock="Top" Margin="14,6,14,0" Spacing="6"
                                    IsVisible="{Binding #NavSplit.IsPaneOpen}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="label" Text="Scenarios" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="ghost" Content="+" Padding="10,2"
                                        Command="{Binding NewScenarioCommand}" ToolTip.Tip="Copy current scenario"/>
                            </Grid>
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                <ListBox Classes="nav" Background="Transparent"
                                         ItemsSource="{Binding Scenarios}"
                                         SelectedItem="{Binding SelectedScenario}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScenarioItem">
                                            <Grid ColumnDefinitions="Auto,Auto,6,*,Auto" Margin="{Binding Indent}">
                                                <TextBlock Grid.Column="0" Text="↳" Margin="0,0,4,0"
                                                           VerticalAlignment="Center" FontSize="12"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           IsVisible="{Binding IsChild}"/>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}"
                                                          VerticalAlignment="Center" ToolTip.Tip="Compare scenario (requires a run)"/>
                                                <Panel Grid.Column="3" VerticalAlignment="Center">
                                                    <StackPanel Spacing="1" IsVisible="{Binding !IsEditing}"
                                                                DoubleTapped="OnScenarioDoubleTapped">
                                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name, StringFormat='{}{0}&#x0a;Double-click to rename'}"/>
                                                        <TextBlock Classes="muted" Text="{Binding Status}"
                                                                   FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}"/>
                                                    </StackPanel>
                                                    <TextBox Name="RenameBox" Text="{Binding EditName}"
                                                             IsVisible="{Binding IsEditing}" FontSize="13"
                                                             Padding="4,2" MinHeight="0"
                                                             KeyDown="OnRenameKeyDown" LostFocus="OnRenameLostFocus"/>
                                                </Panel>
                                                <Button Grid.Column="4" Classes="danger" Content="✕" Padding="5,1"
                                                        FontSize="11" VerticalAlignment="Center" ToolTip.Tip="Remove scenario"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveScenarioCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                            <Button Content="Compare selected" IsVisible="{Binding CanCompare}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Background="{DynamicResource Accent}" Foreground="White" Padding="10,6"
                                    Command="{Binding CompareCommand}"/>
                            <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="0,8,0,0"/>
                        </StackPanel>

                        <ListBox Classes="nav" Margin="10,8,10,10"
                                 ItemsSource="{Binding NavItems}"
                                 SelectedItem="{Binding SelectedNav}">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem" x:DataType="vm:NavItem">
                                    <Setter Property="IsEnabled" Value="{Binding !IsHeader}"/>
                                </Style>
                                <Style Selector="ListBoxItem:disabled">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Padding" Value="12,12,12,3"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavItem">
                                    <Panel>
                                        <TextBlock Classes="label" Text="{Binding Title}"
                                                   VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.IsVisible>
                                                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                    <Binding Path="IsHeader"/>
                                                    <Binding Path="IsPaneOpen" ElementName="NavSplit"/>
                                                </MultiBinding>
                                            </TextBlock.IsVisible>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Spacing="12"
                                                    IsVisible="{Binding !IsHeader}" ToolTip.Tip="{Binding Title}"
                                                    ToolTip.IsEnabled="{Binding !#NavSplit.IsPaneOpen}">
                                            <TextBlock Text="{Binding Icon}" FontSize="16" Width="20"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                       FontSize="14"
                                                       IsVisible="{Binding #NavSplit.IsPaneOpen}"/>
                                        </StackPanel>
                                    </Panel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </SplitView.Pane>

            <ContentControl Content="{Binding SelectedNav.ViewModel}"/>
        </SplitView>
    </DockPanel>
</Window>
