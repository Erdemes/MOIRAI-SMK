<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MOIRAI.ViewModels"
             xmlns:domain="using:MOIRAI.Domain"
             xmlns:views="using:MOIRAI.Views"
             x:Class="MOIRAI.Views.PilotsView"
             x:DataType="vm:PilotsViewModel">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Classes="h1" Text="Pilots" Margin="0,0,0,18"/>

        <Grid Grid.Row="1" ColumnDefinitions="280,18,*">

            <DockPanel Grid.Column="0">
                <Button DockPanel.Dock="Bottom" Classes="ghost" Margin="0,10,0,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="OnNewPilot" Content="+ New pilot"/>
                <Border Classes="card" Padding="6">
                    <ListBox ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:Pilot">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="4"
                                            Padding="6,1" VerticalAlignment="Center" MinWidth="36">
                                        <TextBlock Text="{Binding DisplayShort}" FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <Border Grid.Column="2" Classes="card">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Spacing="14" Margin="0,0,0,14">
                        <TextBlock Classes="h2" Text="Pilot Details"/>
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   IsVisible="{Binding !HasSelection}"
                                   Text="Select a pilot."/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding HasSelection}">
                        <StackPanel Spacing="14" Margin="0,0,12,0">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="Name"/>
                                <TextBox Text="{Binding EditName}" PlaceholderText="e.g. Name Surname"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="Schedule name (max 4 characters)"/>
                                <TextBox Text="{Binding EditShortName}" MaxLength="4" PlaceholderText="e.g. AHM"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="Qualifications (comma-separated)"/>
                                <TextBox Text="{Binding EditQualifications}" PlaceholderText="e.g. Radar, EOTS, Weapons"/>
                            </StackPanel>

                            <StackPanel Spacing="6" IsVisible="{Binding HasAircraft}">
                                <TextBlock Classes="label" Text="Type ratings (none = all)"/>
                                <Border Classes="row">
                                    <ItemsControl ItemsSource="{Binding TypeRatingOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SelectableOption">
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                                          Margin="0,0,16,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="Assigned campaigns"/>
                                <TextBlock Classes="muted" Text="Not assigned to any campaign."
                                           IsVisible="{Binding !HasAssignedCampaigns}"/>
                                <ItemsControl ItemsSource="{Binding AssignedCampaigns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="domain:Campaign">
                                            <Border Classes="row">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Classes="muted"
                                                                   Text="{Binding StartDate, StringFormat=yyyy-MM-dd}"/>
                                                        <TextBlock Classes="muted" Text="→"/>
                                                        <TextBlock Classes="muted"
                                                                   Text="{Binding TargetEndDate, StringFormat=yyyy-MM-dd}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="label" Text="Leave windows"/>
                                <views:WindowPlannerView DataContext="{Binding Planner}"/>

                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Spacing="10" Margin="0,14,0,0"
                                IsVisible="{Binding HasSelection}">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Danger}"
                                   IsVisible="{Binding HasError}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Save" Command="{Binding SaveCommand}"
                                    Background="{DynamicResource Accent}" Foreground="White"/>
                            <Button Classes="danger" Content="Delete"
                                    Command="{Binding DeleteCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Classes="card" Margin="0,18,0,0">
            <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Leave Calendar"/>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto" MaxHeight="320">
                    <views:WindowsCalendarControl Data="{Binding CalendarData}"
                                                  Interactive="True"
                                                  WindowChangedCommand="{Binding ApplyWindowChangeCommand}"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
