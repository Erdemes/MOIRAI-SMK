<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MOIRAI.ViewModels"
             xmlns:domain="using:MOIRAI.Domain"
             xmlns:views="using:MOIRAI.Views"
             x:Class="MOIRAI.Views.AircraftView"
             x:DataType="vm:AircraftViewModel">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Classes="h1" Text="Aircraft" Margin="0,0,0,18"/>

        <Grid Grid.Row="1" ColumnDefinitions="280,18,*">

            <DockPanel Grid.Column="0">
                <Button DockPanel.Dock="Bottom" Classes="ghost" Margin="0,10,0,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="OnNewAircraft" Content="+ New aircraft"/>
                <Border Classes="card" Padding="6">
                    <ListBox ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:Aircraft">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="14"/>
                                    <TextBlock Classes="muted" Text="{Binding Id}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <Border Grid.Column="2" Classes="card">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Spacing="14" Margin="0,0,0,14">
                        <TextBlock Classes="h2" Text="Aircraft Details"/>
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   IsVisible="{Binding !HasSelection}"
                                   Text="Select an aircraft."/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding HasSelection}">
                        <StackPanel Spacing="14" Margin="0,0,12,0">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="Tail number"/>
                                <TextBlock Text="{Binding SelectedItem.Id, FallbackValue=''}" FontSize="14"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,14,*">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Classes="label" Text="Name"/>
                                    <TextBox Text="{Binding EditName}" PlaceholderText="e.g. DTA-1"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Classes="label" Text="Minimum flight crew"/>
                                    <NumericUpDown Value="{Binding EditMinPilots}" Minimum="1" Increment="1" FormatString="0" ToolTip.Tip="Each sortie requires at least this many pilots."/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="Assigned campaigns"/>
                                <TextBlock Classes="muted" Text="Not assigned to any campaign."
                                           IsVisible="{Binding !HasAssignedCampaigns}"/>
                                <ItemsControl ItemsSource="{Binding AssignedCampaigns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="domain:Campaign">
                                            <Border Classes="row">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Classes="muted"
                                                                   Text="{Binding StartDate, StringFormat=yyyy-MM-dd}"/>
                                                        <TextBlock Classes="muted" Text="→"/>
                                                        <TextBlock Classes="muted"
                                                                   Text="{Binding TargetEndDate, StringFormat=yyyy-MM-dd}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="label" Text="Maintenance Plans"/>
                                <views:WindowPlannerView DataContext="{Binding Planner}"/>
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           Text="Inclusive dates"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="label" Text="Periodic Maintenance"/>
                                <Border Classes="row">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,*,32">
                                            <TextBlock Grid.Column="0" Classes="label" Text="Every (flight hrs)"/>
                                            <TextBlock Grid.Column="1" Classes="label" Text="Down time (days)"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding PeriodicRules}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="domain:PeriodicMaintenanceRule">
                                                    <Grid ColumnDefinitions="*,*,32" Margin="0,2">
                                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                                   Text="{Binding IntervalFlightHours, StringFormat='{}{0:0.#} h'}"/>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                                   Text="{Binding DurationDays, StringFormat='{}{0} day(s)'}"/>
                                                        <Button Grid.Column="2" Classes="danger" Content="✕" Padding="6,2" ToolTip.Tip="Remove rule"
                                                                Command="{Binding $parent[UserControl].((vm:AircraftViewModel)DataContext).RemovePeriodicRuleCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Classes="muted" Text="No periodic maintenance."
                                                   IsVisible="{Binding !HasPeriodicRules}"/>
                                    </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,8,*,8,Auto">
                                    <NumericUpDown Grid.Column="0" Value="{Binding EditRuleIntervalHours}"
                                                   Minimum="1" Increment="10" FormatString="0.#"/>
                                    <NumericUpDown Grid.Column="2" Value="{Binding EditRuleDurationDays}"
                                                   Minimum="1" Increment="1" FormatString="0"/>
                                    <Button Grid.Column="4" Classes="ghost" Content="+ Add"
                                            Command="{Binding AddPeriodicRuleCommand}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="label" Text="Reliability (unscheduled maintenance)"/>
                                <Grid ColumnDefinitions="*,8,*,8,*">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Classes="label" Text="Failures / 100 flight h"/>
                                        <NumericUpDown Value="{Binding EditFailureRate}"
                                                       Minimum="0" Increment="0.5" FormatString="0.##" ToolTip.Tip="0 disables random failures. Monte Carlo only."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Classes="label" Text="Repair min (days)"/>
                                        <NumericUpDown Value="{Binding EditRepairDaysMin}"
                                                       Minimum="1" Increment="1" FormatString="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Spacing="4">
                                        <TextBlock Classes="label" Text="Repair max (days)"/>
                                        <NumericUpDown Value="{Binding EditRepairDaysMax}"
                                                       Minimum="1" Increment="1" FormatString="0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Spacing="10" Margin="0,14,0,0"
                                IsVisible="{Binding HasSelection}">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Danger}"
                                   IsVisible="{Binding HasError}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Save" Command="{Binding SaveCommand}"
                                    Background="{DynamicResource Accent}" Foreground="White"/>
                            <Button Classes="danger" Content="Delete"
                                    Command="{Binding DeleteCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Classes="card" Margin="0,18,0,0">
            <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Maintenance Calendar"/>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto" MaxHeight="320">
                    <views:WindowsCalendarControl Data="{Binding CalendarData}"
                                                  Interactive="True"
                                                  WindowChangedCommand="{Binding ApplyWindowChangeCommand}"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
