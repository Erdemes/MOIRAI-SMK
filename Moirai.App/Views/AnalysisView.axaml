<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MOIRAI.ViewModels"
             xmlns:views="using:MOIRAI.Views"
             x:Class="MOIRAI.Views.AnalysisView"
             x:DataType="vm:AnalysisViewModel">

    <Grid Margin="20" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,18">
            <TextBlock Classes="h1" Text="Analysis"/>

        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" HorizontalAlignment="Stretch">

                <Expander Classes="panel" IsExpanded="True">
                    <Expander.Header><TextBlock Classes="h2" Text="Monte Carlo"/></Expander.Header>
                    <StackPanel Spacing="10">

                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ModelHint}"/>

                        <Grid ColumnDefinitions="Auto,16,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="label" Text="Runs"/>
                                <NumericUpDown Value="{Binding Runs}" Minimum="1" Increment="1000"
                                               FormatString="0" Width="240" ToolTip.Tip="More runs reduce sampling noise and increase run time."/>
                            </StackPanel>
                            <Button Grid.Column="2" VerticalAlignment="Bottom"
                                    Content="Run Monte Carlo" Command="{Binding RunCommand}"
                                    IsEnabled="{Binding CanStart}" Padding="20,8"
                                    Background="{DynamicResource Accent}" Foreground="White"/>
                        </Grid>

                        <CheckBox Content="Advanced planning engine"
                                  IsChecked="{Binding McUseAdvancedEngine}" ToolTip.Tip="Smarter scheduling increases run time. Re-run to apply."/>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Danger}"
                                   IsVisible="{Binding HasError}" TextWrapping="Wrap"/>
                        <TextBlock Classes="muted" Text="Running…"
                                   IsVisible="{Binding IsRunning}"/>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0"
                                    IsVisible="{Binding CanRun}">
                            <Button Content="Export analysis to Excel…" Classes="ghost"
                                    Command="{Binding ExportExcelCommand}"
                                    IsVisible="{Binding HasExportableResults}"/>
                            <Button Content="Export PDF report…" Classes="ghost"
                                    Command="{Binding ExportPdfCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Expander Classes="panel" IsExpanded="True" IsVisible="{Binding HasResult}">
                    <Expander.Header><TextBlock Classes="h2" Text="Deadline confidence"/></Expander.Header>
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding PDeliveryText}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{Binding PDeliveryBrush}"/>
                        <TextBlock Text="{Binding EffortText}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Classes="muted" Text="{Binding Summary}"/>

                        <Border Background="{DynamicResource SidebarBg}" CornerRadius="6" Padding="12,8">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           Text="P(meet): chance of meeting the target. Green ≥80%, amber 50 to &lt;80%, red &lt;50%."/>
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           Text="P10 / P50 / P90: completion percentiles, excluding unfinished runs."/>

                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="*,96,170,46,108,92,92,92,78,120,72" Margin="4,0">
                            <TextBlock Grid.Column="0" Classes="label" Text="Campaign"/>
                            <TextBlock Grid.Column="1" Classes="label" Text="Target"/>
                            <TextBlock Grid.Column="2" Classes="label" Text="P(meet) - line = 80%"/>
                            <TextBlock Grid.Column="4" Classes="label" Text="Verdict"/>
                            <TextBlock Grid.Column="5" Classes="label" Text="P10 end"/>
                            <TextBlock Grid.Column="6" Classes="label" Text="P50 end"/>
                            <TextBlock Grid.Column="7" Classes="label" Text="P90 end"/>
                            <TextBlock Grid.Column="8" Classes="label" Text="Incomplete"/>
                            <TextBlock Grid.Column="9" Classes="label" Text="Sorties P10/50/90"/>
                            <TextBlock Grid.Column="10" Classes="label" Text="Aborted"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Risks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CampaignRiskRow">
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="*,96,170,46,108,92,92,92,78,120,72">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Target}"
                                                       Classes="muted" VerticalAlignment="Center"/>

                                            <Grid Grid.Column="2" Height="18" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding PMeet}"
                                                             Foreground="{Binding Bar}" Height="18"/>
                                                <Grid ColumnDefinitions="4*,1*" IsHitTestVisible="False">
                                                    <Border Grid.Column="1" Width="1" HorizontalAlignment="Left"
                                                            Background="{DynamicResource TextPrimary}" Opacity="0.55"/>
                                                </Grid>
                                            </Grid>

                                            <TextBlock Grid.Column="3" Text="{Binding PMeetText}"
                                                       Foreground="{Binding Bar}"
                                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Verdict}"
                                                       Foreground="{Binding Bar}"
                                                       VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <Button Grid.Column="5" Background="Transparent" Padding="0"
                                                    Cursor="Hand" VerticalAlignment="Center"
                                                    IsEnabled="{Binding HasP10}" ToolTip.Tip="View this simulated schedule."
                                                    Command="{Binding $parent[UserControl].((vm:AnalysisViewModel)DataContext).OpenP10Command}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding P10}" Classes="muted"
                                                           TextDecorations="Underline"/>
                                            </Button>
                                            <Button Grid.Column="6" Background="Transparent" Padding="0"
                                                    Cursor="Hand" VerticalAlignment="Center"
                                                    IsEnabled="{Binding HasP50}" ToolTip.Tip="View this simulated schedule."
                                                    Command="{Binding $parent[UserControl].((vm:AnalysisViewModel)DataContext).OpenP50Command}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding P50}" Foreground="{Binding P50Brush}"
                                                           FontWeight="SemiBold" TextDecorations="Underline"/>
                                            </Button>
                                            <Button Grid.Column="7" Background="Transparent" Padding="0"
                                                    Cursor="Hand" VerticalAlignment="Center"
                                                    IsEnabled="{Binding HasP90}" ToolTip.Tip="View this simulated schedule."
                                                    Command="{Binding $parent[UserControl].((vm:AnalysisViewModel)DataContext).OpenP90Command}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding P90}" Classes="muted"
                                                           TextDecorations="Underline"/>
                                            </Button>
                                            <TextBlock Grid.Column="8" Text="{Binding Incomplete}" Classes="muted" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="9" Text="{Binding Sorties}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="10" Text="{Binding Aborted}" Classes="muted" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <Expander Classes="panel" IsExpanded="True" IsVisible="{Binding HasRun}">
                    <Expander.Header><TextBlock Classes="h2" Text="Criticality &amp; float"/></Expander.Header>
                    <StackPanel Spacing="10">
                        <Button HorizontalAlignment="Left" Content="Find critical path"
                                Command="{Binding RunCriticalityCommand}"
                                IsEnabled="{Binding CanRunCriticality}" Padding="16,7"
                                Background="{DynamicResource Accent}" Foreground="White"/>
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Free float: delay allowed without moving program finish. Zero float marks the critical chain."/>
                        <TextBlock Text="{Binding CriticalityError}" Foreground="{DynamicResource Danger}"
                                   TextWrapping="Wrap" IsVisible="{Binding HasCriticalityError}"/>

                        <StackPanel Spacing="6" IsVisible="{Binding HasCriticality}">
                            <TextBlock Text="{Binding CriticalitySummary}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>

                            <Grid ColumnDefinitions="180,110,70,*" Margin="4,6,4,0">
                                <TextBlock Grid.Column="0" Classes="label" Text="Campaign"/>
                                <TextBlock Grid.Column="1" Classes="label" Text="Finish"/>
                                <TextBlock Grid.Column="2" Classes="label" Text="Float"/>
                                <TextBlock Grid.Column="3" Classes="label" Text="Status"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Criticality}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CampaignCriticalityRow">
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="180,110,70,*">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Finish}" Classes="muted" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Float}"
                                                           Foreground="{Binding Brush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Status}"
                                                           Foreground="{Binding Brush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="label" Text="Assets" Margin="4,8,4,0"/>
                            <TextBlock Classes="muted" Text="No critical resources found."
                                       IsVisible="{Binding !HasCriticalResources}" Margin="4,0"/>
                            <ItemsControl ItemsSource="{Binding CriticalResources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ResourceCriticalityRow">
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="180,110,*">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Kind}" Classes="muted" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Impact}"
                                                           Foreground="{Binding Brush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Expander Classes="panel" IsExpanded="True" IsVisible="{Binding CanRun}">
                    <Expander.Header><TextBlock Classes="h2" Text="Risk decomposition"/></Expander.Header>
                    <StackPanel Spacing="10">
                        <Button HorizontalAlignment="Left" Content="Decompose risks"
                                Command="{Binding DecomposeRiskCommand}"
                                IsEnabled="{Binding CanStart}" Padding="16,7"
                                Background="{DynamicResource Accent}" Foreground="White"/>

                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="P(program): on-time delivery probability with only the listed risk active."/>

                        <StackPanel Spacing="6" IsVisible="{Binding HasDecomposition}">
                            <Grid ColumnDefinitions="150,100,110,110,110,110,120" Margin="4,0">
                                <TextBlock Grid.Column="0" Classes="label" Text="Source"/>
                                <TextBlock Grid.Column="1" Classes="label" Text="P(program)"/>
                                <TextBlock Grid.Column="2" Classes="label" Text="Finish P10"/>
                                <TextBlock Grid.Column="3" Classes="label" Text="Finish P50"/>
                                <TextBlock Grid.Column="4" Classes="label" Text="Finish P90"/>
                                <TextBlock Grid.Column="5" Classes="label" Text="Range (P10→P90)"/>
                                <TextBlock Grid.Column="6" Classes="label" Text="Sorties P50 / P90"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Decomposition}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DecompositionRow">
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="150,100,110,110,110,110,120">
                                                <TextBlock Grid.Column="0" Text="{Binding Source}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding PDelivery}"
                                                           Foreground="{Binding PDeliveryBrush}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FinishP10}" Classes="muted" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding FinishP50}" Classes="muted" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding FinishP90}" Classes="muted" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding Range}"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="{Binding Sorties}" Classes="muted" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding DecompositionSummary}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Expander Classes="panel" IsExpanded="True" IsVisible="{Binding CanRun}">
                    <Expander.Header><TextBlock Classes="h2" Text="Sensitivity analysis"/></Expander.Header>
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,12,Auto,12,Auto">
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Bottom" ToolTip.Tip="More runs reduce sampling noise and increase run time.">
                                <TextBlock Classes="label" Text="MC runs"/>
                                <NumericUpDown Value="{Binding SensitivityRuns}" Minimum="1" Increment="50"
                                               FormatString="0" Width="110"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Bottom" ToolTip.Tip="More samples improve stability and increase run time. Use 128, 256, 512 or 1024.">
                                <TextBlock Classes="label" Text="Importance samples"/>
                                <NumericUpDown Value="{Binding SensitivitySamples}" Minimum="16" Increment="64"
                                               FormatString="0" Width="130"/>
                            </StackPanel>
                            <Button Grid.Column="5" VerticalAlignment="Bottom"
                                    Content="Run sensitivity" Command="{Binding RunSensitivityCommand}"
                                    IsEnabled="{Binding CanStart}" Padding="16,7"
                                    Background="{DynamicResource Accent}" Foreground="White"/>
                        </Grid>
                        <CheckBox Content="Compare P10 / P50 / P90 plan orders"
                                  IsChecked="{Binding OrderSpread}" ToolTip.Tip="Requires the advanced engine. Roughly triples tornado and sweep run time."/>

                        <TextBlock Text="{Binding SensitivityError}" Foreground="{DynamicResource Danger}"
                                   IsVisible="{Binding HasSensitivityError}" TextWrapping="Wrap"/>

                        <StackPanel Spacing="10" IsVisible="{Binding HasSensitivity}">
                            <TextBlock Classes="label" Text="Effect on delivery probability"/>
                            <views:TornadoControl Data="{Binding SensitivityChart}" MinHeight="80"/>

                            <TextBlock Classes="label" Text="Parameter importance"
                                       Margin="0,6,0,0"/>
                            <views:SobolBarsControl Data="{Binding GlobalImportanceChart}" MinHeight="80"/>
                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="4,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="12" CornerRadius="2" VerticalAlignment="Center"
                                            Background="#4C8DFF"/>
                                    <TextBlock Classes="muted" Text="On its own" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="12" CornerRadius="2" VerticalAlignment="Center"
                                            Background="#5A4C8DFF"/>
                                    <TextBlock Classes="muted" Text="In combination with others" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding GlobalImportanceSummary}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>

                            <TextBlock Classes="label" Margin="0,6,0,0"
                                       Text="Parameter sweeps"/>
                            <ItemsControl ItemsSource="{Binding Sweeps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ParameterSweepRow">
                                        <Border Classes="card" Width="468" Margin="0,4,16,12" Padding="14,10">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,0,0,4"/>
                                                <Grid ColumnDefinitions="80,200,56,120" Margin="2,0">
                                                    <TextBlock Grid.Column="0" Classes="label" Text="Setting"/>
                                                    <TextBlock Grid.Column="1" Classes="label" Text="P(program)"/>
                                                    <TextBlock Grid.Column="3" Classes="label" Text="Finish P50"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Points}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SweepPointRow">
                                                            <Border Classes="row">
                                                                <Grid ColumnDefinitions="80,200,56,120,*">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
                                                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Height="16"
                                                                                 Value="{Binding PDelivery}" Foreground="{Binding Bar}"
                                                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding PText}" Foreground="{Binding Bar}"
                                                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding FinishP50}" Classes="muted"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding BandText}" FontSize="11"
                                                                               Foreground="#FFBF1F" VerticalAlignment="Center"
                                                                               IsVisible="{Binding HasBand}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding SensitivitySummary}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Expander Classes="panel" IsExpanded="True" IsVisible="{Binding CanRun}">
                    <Expander.Header><TextBlock Classes="h2" Text="Resource recommendation"/></Expander.Header>
                    <StackPanel Spacing="10">

                        <WrapPanel>
                            <CheckBox Content="Add pilot" IsChecked="{Binding LeverAddPilot}" Margin="0,0,18,4"/>
                            <CheckBox Content="Add FTE" IsChecked="{Binding LeverAddEngineer}" Margin="0,0,18,4"/>
                            <CheckBox Content="Add aircraft" IsChecked="{Binding LeverAddAircraft}" Margin="0,0,18,4"/>
                            <CheckBox Content="Add simulator" IsChecked="{Binding LeverAddSimulator}" Margin="0,0,18,4"/>
                            <CheckBox Content="Reassign existing crew" IsChecked="{Binding LeverReassign}" Margin="0,0,18,4"/>
                            <CheckBox Content="Loosen daily limits" IsChecked="{Binding LeverDailyLimits}" Margin="0,0,18,4"/>
                            <CheckBox Content="Raise test points / sortie" IsChecked="{Binding LeverTestPoints}" Margin="0,0,18,4"/>
                            <CheckBox Content="Improve retest rate" IsChecked="{Binding LeverImproveRetest}" Margin="0,0,18,4" ToolTip.Tip="Reduces starting retest probability by 25%."/>
                            <CheckBox Content="Reduce aborts" IsChecked="{Binding LeverReduceAborts}" Margin="0,0,18,4" ToolTip.Tip="Halves abort probability for failing campaigns or the program override."/>
                        </WrapPanel>

                        <Grid ColumnDefinitions="Auto,16,Auto,16,Auto,16,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="label" Text="Target confidence (%)"/>
                                <NumericUpDown Value="{Binding TargetConfidence}" Minimum="1" Maximum="100"
                                               Increment="5" FormatString="0" Width="130"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Classes="label" Text="Max steps"/>
                                <NumericUpDown Value="{Binding MaxSteps}" Minimum="1" Increment="1"
                                               FormatString="0" Width="110"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Spacing="4">
                                <TextBlock Classes="label" Text="Search runs (N)"/>
                                <NumericUpDown Value="{Binding SweepRuns}" Minimum="1" Increment="50"
                                               FormatString="0" Width="120"/>
                            </StackPanel>
                            <Button Grid.Column="6" VerticalAlignment="Bottom"
                                    Content="Recommend fixes" Command="{Binding RecommendCommand}"
                                    IsEnabled="{Binding CanRecommend}" Padding="20,8"
                                    Background="{DynamicResource Accent}" Foreground="White"/>
                        </Grid>

                        <TextBlock Text="{Binding RecommendError}" Foreground="{DynamicResource Danger}"
                                   IsVisible="{Binding HasRecommendError}" TextWrapping="Wrap"/>
                        <TextBlock Classes="muted" Text="Searching…"
                                   IsVisible="{Binding IsRecommending}"/>

                        <StackPanel Spacing="8" IsVisible="{Binding HasRecommendation}">
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RecommendStepRow">
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="28,*">
                                                <TextBlock Grid.Column="0" Text="{Binding Order}" Classes="muted" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Addition}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Effect}" Classes="muted" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding RecommendationSummary}" TextWrapping="Wrap"
                                       Foreground="{Binding RecommendationSummaryBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
