<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MOIRAI.ViewModels"
             xmlns:domain="using:MOIRAI.Domain"
             xmlns:views="using:MOIRAI.Views"
             x:Class="MOIRAI.Views.SimulatorsView"
             x:DataType="vm:SimulatorsViewModel">
    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Classes="h1" Text="Simulators" Margin="0,0,0,8"/>

        <Border Grid.Row="1" Classes="card" Margin="0,0,0,14" Padding="14,10">
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding CapacitySummary}"/>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="280,18,*">

            <DockPanel Grid.Column="0">
                <Button DockPanel.Dock="Bottom" Classes="ghost" Margin="0,10,0,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="OnNewSimulator" Content="+ New simulator"/>
                <Border Classes="card" Padding="6">
                    <ListBox ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:Simulator">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="14"/>
                                    <TextBlock Classes="muted"
                                               Text="{Binding MaintenanceWindows.Count, StringFormat='{}{0} maintenance window(s)'}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <Border Grid.Column="2" Classes="card">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Spacing="14" Margin="0,0,0,14">
                        <TextBlock Classes="h2" Text="Simulator Details"/>
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   IsVisible="{Binding !HasSelection}"
                                   Text="Select a simulator."/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding HasSelection}">
                        <StackPanel Spacing="14" Margin="0,0,12,0">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="Name"/>
                                <TextBox Text="{Binding EditName}" PlaceholderText="e.g. Full-flight sim A"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,14,*">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Classes="label" Text="Base"/>
                                    <ComboBox ItemsSource="{Binding LocationOptions}"
                                              SelectedIndex="{Binding EditLocationIndex}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Classes="label" Text="Max blocks / day (0 = all)"/>
                                    <NumericUpDown Value="{Binding EditMaxBlocksPerDay}"
                                                   Minimum="0" Increment="1" FormatString="0"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="label" Text="Reliability (unscheduled maintenance)"/>
                                <Grid ColumnDefinitions="*,8,*,8,*">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Classes="label" Text="Failures / 100 reh. h"/>
                                        <NumericUpDown Value="{Binding EditFailureRate}"
                                                       Minimum="0" Increment="0.5" FormatString="0.##" ToolTip.Tip="0 disables random failures. Monte Carlo only."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Classes="label" Text="Repair min (days)"/>
                                        <NumericUpDown Value="{Binding EditRepairDaysMin}"
                                                       Minimum="1" Increment="1" FormatString="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Spacing="4">
                                        <TextBlock Classes="label" Text="Repair max (days)"/>
                                        <NumericUpDown Value="{Binding EditRepairDaysMax}"
                                                       Minimum="1" Increment="1" FormatString="0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           Text="Failures apply to Monte Carlo only."/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="label" Text="Maintenance / downtime windows"/>
                                <views:WindowPlannerView DataContext="{Binding Planner}"/>

                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Spacing="10" Margin="0,14,0,0"
                                IsVisible="{Binding HasSelection}">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Danger}"
                                   IsVisible="{Binding HasError}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Save" Command="{Binding SaveCommand}"
                                    Background="{DynamicResource Accent}" Foreground="White"/>
                            <Button Classes="danger" Content="Delete"
                                    Command="{Binding DeleteCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Classes="card" Margin="0,18,0,0">
            <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Maintenance Calendar"/>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto" MaxHeight="320">
                    <views:WindowsCalendarControl Data="{Binding CalendarData}"
                                                  Interactive="True"
                                                  WindowChangedCommand="{Binding ApplyWindowChangeCommand}"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
